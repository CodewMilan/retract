+  env: {...process.env, PYTHONPATH: 'src'}, stdio: ['pipe', 'pipe', 'inherit'],
+});
+const exit = once(fixture, 'exit');
+const lines = createInterface({input: fixture.stdout});
+const ready = once(lines, 'line').then(([line]) => JSON.parse(line));
+let browser;
+let passed = 0;
+const check = async (name, run) => { await run(); passed++; console.log(`PASS ${name}`); };
+try {
+  const info = await Promise.race([ready, exit.then(([code]) => { throw new Error(`Fixture exited before ready: ${code}`); })]);
+  const base = info.url;
+  console.log(`Fixture: ${base}; disposable schema: ${info.schema}`);
+  lines.on('line', line => console.log(`Fixture cleanup: ${line}`));
+  browser = await chromium.launch({headless: true});
+  const context = await browser.newContext();
+  const page = await context.newPage();
+  page.setDefaultTimeout(10000);
+  const errors = [];
+  page.on('pageerror', e => errors.push(e.message));
+  const waitStatus = text => page.locator('#status').filter({hasText: text}).waitFor();
+  const login = async (user = 'alice') => {
+    await page.getByLabel('Demo account').selectOption(user);
+    await page.getByRole('button', {name: 'Sign in', exact: true}).click();
+    await waitStatus('Your profile is ready.');
+  };
+  const session = () => page.evaluate(() => fetch('/api/session').then(r => r.json()));

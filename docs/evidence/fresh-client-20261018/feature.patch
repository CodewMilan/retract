+++ b/examples/account-settings/settings.js
@@ -0,0 +1,112 @@
+const $ = id => document.getElementById(id);
+let session = null;
+let busy = false;
+
+function status(message) { $('status').textContent = message; }
+function error(message = '') {
+  $('error').textContent = message;
+  $('error').hidden = !message;
+}
+function setBusy(value) {
+  busy = value;
+  $('account').setAttribute('aria-busy', String(value));
+  document.querySelectorAll('button, select, #name').forEach(control => { control.disabled = value; });
+}
+function clearValidation() {
+  $('name').removeAttribute('aria-invalid');
+  $('name-error').hidden = true;
+}
+function signedOut(message = 'You’re signed out.') {
+  session = null;
+  $('profile').hidden = true;
+  $('profile').reset();
+  clearValidation();
+  $('login').hidden = false;
+  status(message);
+}
+function signedIn(data) {
+  if (!data.user || !data.csrf_token) throw new Error('Your profile could not be loaded. Retry your session.');
+  session = data;
+  $('login').hidden = true;
+  $('profile').hidden = false;
+  $('email').value = data.user.email;
+  $('name').value = data.user.display_name;
+  clearValidation();
+  status('Your profile is ready.');
+}
+async function request(path, method = 'GET', body) {
+  const headers = {};
+  if (body !== undefined) headers['Content-Type'] = 'application/json';
+  if (method !== 'GET' && session) headers['X-CSRF-Token'] = session.csrf_token;
+  let response;
+  try {
+    response = await fetch(path, {method, credentials: 'same-origin', headers,
+      body: body === undefined ? undefined : JSON.stringify(body)});
+  } catch {
+    throw new Error('Could not reach the demo. Check your connection and try again.');
+  }
+  const data = await response.json();
+  if (!response.ok) {
+    const failure = new Error(data.error || 'Request failed. Try again.');
+    failure.status = response.status;
+    throw failure;
+  }
+  return data;
+}
+async function recover() {
+  if (busy) return;
+  setBusy(true); error(); $('retry').hidden = true;
+  status('Loading your session…');
+  try { signedIn(await request('/api/session')); }
+  catch (failure) {
+    if (failure.status === 401) signedOut();
+    else { status('Session unavailable.'); error(failure.message); $('retry').hidden = false; }
+  } finally { setBusy(false); }
+}
+$('retry').addEventListener('click', recover);
+$('login').addEventListener('submit', async event => {
+  event.preventDefault();
+  if (busy) return;
+  setBusy(true); error(); status('Signing in…');
+  let success = false;
+  try {
+    signedIn(await request('/demo/login', 'POST', {user_id: $('user').value}));
+    success = true;
+  } catch (failure) { status('Sign-in failed.'); error(failure.message); }
+  finally { setBusy(false); if (success) $('name').focus(); }
+});
+$('name').addEventListener('input', () => { clearValidation(); error(); status('Unsaved changes.'); });
+$('profile').addEventListener('submit', async event => {
+  event.preventDefault();
+  if (busy || !session) return;
+  const displayName = $('name').value.trim();
+  if ([...displayName].length < 1 || [...displayName].length > 80) {
+    $('name-error').textContent = 'Enter a display name with 1–80 characters.';
+    $('name-error').hidden = false;
+    $('name').setAttribute('aria-invalid', 'true');
+    $('name').focus();
+    status('Changes have not been saved.');
+    return;
+  }
+  setBusy(true); error(); status('Saving changes…');
+  try {
+    const result = await request(`/api/profiles/${encodeURIComponent(session.user.id)}`, 'PATCH', {display_name: displayName});
+    session.user = result.user;
+    $('name').value = result.user.display_name;
+    status('Changes saved.');
+  } catch (failure) {
+    if (failure.status === 401) signedOut('Your session ended. Sign in again.');
+    else status('Changes have not been saved.');
+    error(failure.message);
+  } finally { setBusy(false); if (!session) $('user').focus(); }
+});
+$('logout').addEventListener('click', async () => {
+  if (busy || !session) return;
+  setBusy(true); error(); status('Signing out…');
+  try { await request('/demo/logout', 'POST', {}); signedOut(); }
+  catch (failure) {
+    if (failure.status === 401) signedOut();
+    else { status('Sign-out failed. Try again.'); error(failure.message); }
+  } finally { setBusy(false); if (!session) $('user').focus(); }
+});
+recover();
